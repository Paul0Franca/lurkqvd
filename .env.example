# Configuração do LurkQVD. Copie para .env e preencha.
# No Docker, o .env é lido pelo docker compose; no desenvolvimento, pela API e pelo worker.

# ---------------------------------------------------------------------------
# Obrigatórias
# ---------------------------------------------------------------------------

# Senha do Postgres do docker compose. Só letras e números (vai dentro de uma URL).
#   gerar: openssl rand -hex 24
POSTGRES_PASSWORD=

# Chave que criptografa os segredos no banco (API key da Qlik, senhas das fontes e do SMTP).
# GUARDE UMA CÓPIA FORA DO SERVIDOR: sem ela, os segredos não podem ser lidos.
#   gerar: openssl rand -base64 32 | tr '+/' '-_'
#      ou: docker run --rm lurkqvd:local chave   (depois do primeiro build)
LURKQVD_FERNET_KEY=

# ---------------------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------------------

# Porta do LurkQVD na máquina (docker compose). Padrão: 8080
# LURKQVD_PORTA=8080

# Imagens publicadas (docker compose pull), em vez de compilar com --build.
# Vazio = lurkqvd:local, compilada na máquina. O front usa a mesma, com "-web" no nome.
# LURKQVD_IMAGEM=ghcr.io/<dono>/lurkqvd
# LURKQVD_VERSAO=0.1.0

# Endereço público do LurkQVD, usado nos links dos e-mails. Ex.: https://lurkqvd.minha-empresa.com
# LURKQVD_URL_APP=

# Senha inicial do admin padrão (login "admin"). Vazio = sorteada e mostrada no log da API.
# Em qualquer caso, a troca é obrigatória no primeiro login.
# LURKQVD_ADMIN_SENHA=

# Tenant da Qlik Cloud sugerido na primeira configuração (o definitivo é salvo pela tela). Ex.: minha-empresa.us
# LURKQVD_QLIK_TENANT=

# Fuso dos agendamentos, dos horários nos e-mails e do gráfico por dia (nome IANA). Padrão: America/Sao_Paulo
# Ao trocar, o worker recalcula o próximo horário de cada agendamento na subida.
# LURKQVD_FUSO=Europe/Lisbon

# Esconde a documentação interativa da API (/api/docs). Padrão: 1 (visível)
# LURKQVD_DOCS=0

# Validade das sessões de login
# LURKQVD_SESSAO_INATIVA_H=12
# LURKQVD_SESSAO_MAX_DIAS=7

# Motor de leitura padrão das fontes: odbc | arrow-odbc | connectorx
# LURKQVD_MOTOR_LEITURA=odbc

# Lotes lidos à frente enquanto o anterior vira QVD (0 = lê e grava em sequência)
# LURKQVD_LOTES_ANTECIPADOS=2

# arrow-odbc: teto do buffer de leitura em MB (reservado em dobro, pelo tamanho máximo das colunas)
# LURKQVD_BUFFER_LEITURA_MB=128

# Memória das cargas (% da RAM da máquina, ou do limite do container): vale para uma carga sozinha e
# para a soma das que rodam juntas nos workers da mesma máquina
# LURKQVD_LIMITE_MEMORIA_PCT=75
# Reserva de uma carga que ainda não rodou (depois vale o pico medido nas últimas execuções)
# LURKQVD_MEMORIA_SEM_HISTORICO_MB=1024
# Colunas com mais valores distintos que isso guardam os valores em disco e são codificadas no fim pelo
# Arrow, em blocos, em vez de numa tabela do Python na memória (~100 bytes por valor distinto)
# LURKQVD_DISTINTOS_PYTHON=250000
# Uma carga esperando memória há mais que isso para de ser ultrapassada pelas menores
# LURKQVD_ESPERA_MAX_MIN=15
# Workers com o mesmo nome dividem a mesma RAM. Com workers em várias máquinas, um nome por máquina.
# LURKQVD_MAQUINA=servidor

# Só no desenvolvimento local (fora do Docker), quando a API e o front estão em portas diferentes:
# LURKQVD_PG_DSN=postgresql://lurkqvd:lurkqvd_dev@127.0.0.1:5433/lurkqvd
# LURKQVD_CORS=http://localhost:5173
